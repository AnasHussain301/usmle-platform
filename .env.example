# Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.synapses.systems/login.html

# Server Port & Security
PORT=5000
JWT_SECRET=generate_a_long_random_secret
ADMIN_EMAILS=authorized-admin@example.com
SUPPORT_EMAIL=support@example.com

# SMTP delivery for the in-app feedback form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_smtp_username

# MongoDB Atlas persistence
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/synapse
